# ==============================================================================
# CareFlow Backend Server Environment Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Security (Required: Generate 32+ char random string in production)
JWT_SECRET=careflow_dev_jwt_secret_change_in_prod_12345
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database
DATABASE_FILE=./healthcare.db
SQLITE_BUSY_TIMEOUT_MS=5000

# AI Triage
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_REFRESH_TOKEN=

# Transactional Email (Mode: ethereal | smtp | log)
EMAIL_SERVICE_MODE=ethereal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CareFlow Health" <notifications@careflow.com>

# Rules & Schedulers
SLOT_HOLD_DURATION_MINUTES=5
MEDICATION_REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/2 * * * *"
SLOT_HOLD_CLEANUP_CRON="* * * * *"
APPOINTMENT_REMINDER_CRON="0 * * * *"
