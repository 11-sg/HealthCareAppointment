# ==============================================================================
# CareFlow Healthcare Appointment & Care Manager — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# NEVER commit sensitive API keys, database credentials, or JWT secrets to Git.

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptography Security
# ------------------------------------------------------------------------------
# In production, generate a secure 64-char key using: openssl rand -base64 48
JWT_SECRET=careflow_dev_jwt_secret_change_in_prod_12345
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 3. Database Persistence
# ------------------------------------------------------------------------------
DATABASE_FILE=./healthcare.db
SQLITE_BUSY_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 4. Google Gemini LLM API (Clinical Pre & Post-Visit Summaries)
# ------------------------------------------------------------------------------
# Leave empty to automatically use internal rule-based heuristic triage fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Google Calendar OAuth 2.0 (Optional Two-way Sync)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Transactional Email Service & SMTP Outbox
# ------------------------------------------------------------------------------
# Options: 'ethereal' (auto test mailbox) | 'smtp' (production mail server) | 'log' (console audit)
EMAIL_SERVICE_MODE=ethereal

# Required if EMAIL_SERVICE_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CareFlow Health" <notifications@careflow.com>

# ------------------------------------------------------------------------------
# 7. Clinical Business Rules & Background Cron Workers
# ------------------------------------------------------------------------------
SLOT_HOLD_DURATION_MINUTES=5
MEDICATION_REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/2 * * * *"
SLOT_HOLD_CLEANUP_CRON="* * * * *"
APPOINTMENT_REMINDER_CRON="0 * * * *"

# ------------------------------------------------------------------------------
# 8. Frontend Vite Client Settings
# ------------------------------------------------------------------------------
VITE_API_URL=/api
